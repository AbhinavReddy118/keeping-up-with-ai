<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-news-digest.monitor</string>

    <key>WorkingDirectory</key>
    <string>/Users/apple/Desktop/ai_news_digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/apple/Desktop/ai_news_digest/.venv/bin/python</string>
        <string>/Users/apple/Desktop/ai_news_digest/monitor.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TELEGRAM_ENABLED</key>
        <string>false</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/apple/Desktop/ai_news_digest/logs/monitor.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/apple/Desktop/ai_news_digest/logs/monitor.stderr.log</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
